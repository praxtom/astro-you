# AstroYou local/production environment template.
# Copy to .env for local development. In Netlify, configure the same keys in Site configuration > Environment variables.
# Never commit real secrets.
# The readiness checker intentionally blocks these sample placeholder values.

# Firebase Admin, server-side
FIREBASE_SERVICE_ACCOUNT={"project_id":"astroyou","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"}
FIREBASE_STORAGE_BUCKET=astroyou.appspot.com

# Firebase client, browser-side
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=astroyou.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=astroyou
VITE_FIREBASE_STORAGE_BUCKET=astroyou.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me
VITE_FIREBASE_VAPID_KEY=

# AI and astrology providers
GEMINI_API_KEY=replace_me
# Optional: override the Gemini model id without a code deploy.
GEMINI_MODEL=gemini-flash-lite-latest
ASTROLOGY_API_KEY=replace_me
# Optional astrology-API spend caps (calls per UTC day / month; 0 blocks all calls) and engine (api|local).
ASTRO_DAILY_CALL_BUDGET=60
ASTRO_MONTHLY_CALL_BUDGET=900
ASTRO_FREE_MATCHES_PER_DAY=60
ASTRO_GUEST_UPSTREAM_PER_IP_HOUR=15
ASTRO_ENGINE=api
# Optional dedicated HMAC secret (>= 32 chars) for cache doc ids; unset = derived from OTP_HASH_SECRET.
CACHE_KEY_SECRET=

# Razorpay payments
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_PREMIUM_PLAN_ID=plan_replace_me
RAZORPAY_PRO_PLAN_ID=plan_replace_me
VITE_RAZORPAY_KEY_ID=rzp_live_replace_me

# Operations
APP_BASE_URL=https://astroyou.app
ASTROYOU_ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=
# Secret used to HMAC one-time login codes at rest. Set a long random value.
OTP_HASH_SECRET=replace_me
# Secret used to HMAC one-click email unsubscribe tokens (List-Unsubscribe).
# Set a DIFFERENT long random value (>= 32 chars). Digest emails are NOT sent
# until this is configured (compliance fail-closed).
EMAIL_UNSUB_SECRET=replace_me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp nudges are OFF unless this is "true" AND approved message templates
# are configured (free-form text is rejected outside the 24h window).
WHATSAPP_NUDGES_ENABLED=false
# Optional cap on a single admin credit adjustment (default 10000).
MAX_ADMIN_CREDIT_ADJUSTMENT=10000

# ── Scheduled-job tuning (all optional; sensible defaults apply if unset) ──
# Per-run batch sizes for the scheduled sweepers.
BRAIN_MAINTENANCE_BATCH_SIZE=
BRAIN_NUDGE_BATCH_SIZE=
CONSULT_REAPER_BATCH_SIZE=
DAILY_DIGEST_BATCH_SIZE=
SUBSCRIPTION_LAPSE_BATCH_SIZE=
# Minutes of inactivity before the reaper force-closes an abandoned consult.
CONSULT_STALE_MINUTES=
# From-address for daily digest emails (falls back to a default sender).
DIGEST_FROM_EMAIL=
# Build-time only (scripts/prerender-seo-pages.mjs): hard ceiling in
# milliseconds on the Panchang prerender phase, so a rate-limited provider
# cannot stall a deploy. Default 90000 (90s) if unset.
PANCHANG_BUDGET_MS=90000

# ── Client toggles (optional) ──
# "true" to emit server-side funnel analytics events.
VITE_ENABLE_SERVER_ANALYTICS=false
# Sentry DSN for client error reporting (blank disables Sentry; the app logs
# to the console instead — see src/lib/reportError.ts).
VITE_SENTRY_DSN=

# Set to "true" only after international payments are activated on the Razorpay
# account. Until then, non-INR checkout is refused server-side rather than
# failing opaquely at the gateway.
RAZORPAY_INTERNATIONAL_ENABLED=false

# ── Operations: alerting, background jobs, build (workstream F) ──
# REQUIRED for launch: DIGEST_FROM_EMAIL (above) is the sender for OTP, digest
# and admin emails, e.g. "AstroYou <noreply@astroyou.app>"; its domain must be
# verified in Resend. RESEND_API_KEY (above) is also required: email OTP
# sign-in fails without it.
# Shared secret for internal background-function dispatch (>= 32 chars, same
# value in every deploy context's functions). Optional: derived from
# OTP_HASH_SECRET when unset.
INTERNAL_FUNCTION_SECRET=
# Slack/Discord-compatible incoming webhook paged on payment, job and email
# failures. Events are always stored in Firestore opsEvents regardless.
OPS_ALERT_WEBHOOK_URL=
# Days opsEvents are kept before the Firestore TTL deletes them (default 30).
OPS_EVENT_TTL_DAYS=
# Daily digest background run: users per slice (default 100000, the ~13-min
# deadline is the real limit), parallel users per slice (default 2), slices
# per day before giving up (default 24), per-slice deadline in ms (max/default
# 780000).
DAILY_DIGEST_CONCURRENCY=
DAILY_DIGEST_MAX_HOPS=
DAILY_DIGEST_DEADLINE_MS=
# Build-time: live Panchang prerender calls run only when CONTEXT=production;
# set to 1 to force them in another context (spends astrology API quota).
PRERENDER_LIVE_PANCHANG=
# check:launch: set to 1 to also run the legal-placeholder test suite.
LEGAL_PLACEHOLDER_CHECK=
