{
  "name": "astroyou",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "pnpm run test:types && pnpm run test:functions",
    "test:types": "tsc -p tsconfig.app.json --noEmit",
    "test:functions": "rm -rf node_modules/.tmp/functions-tests && tsc -p tsconfig.functions-test.json && node scripts/run-function-tests.mjs",
    "build": "tsc -b && vite build && node scripts/prerender-seo-pages.mjs",
    "lint": "eslint .",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "check:market": "node scripts/check-market-readiness.mjs",
    "check:market:live": "node scripts/check-market-readiness.mjs --live",
    "check:services": "node scripts/verify-live-services.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@netlify/functions": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^13.1.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.31.0",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
