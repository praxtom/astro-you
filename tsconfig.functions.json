{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "netlify/functions/**/*.ts",
    "src/types/**/*.ts",
    "src/lib/**/*.ts"
  ],
  "exclude": ["netlify/functions/__tests__/**"]
}
