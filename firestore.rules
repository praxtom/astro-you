rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Contact points our scheduled jobs could deliver to. The jobs read the
    // recipient only from verified sources (Firebase Auth email, server-written
    // verifiedContacts), but these fields stay server-owned as well, so a
    // client can never point a digest/nudge at someone else's inbox or phone.
    // `email` may only ever be set to the caller's own token email.
    function profileField(data, key) {
      // `profile` may be absent or literally null on older docs.
      return data.get('profile', null) is map ? data.profile.get(key, null) : null;
    }
    function contactFieldsCreateOk() {
      return (request.resource.data.get('email', null) == null
                || request.resource.data.email == request.auth.token.get('email', null))
          && !('phoneE164' in request.resource.data)
          && !('whatsappNumber' in request.resource.data)
          && !('verifiedContacts' in request.resource.data)
          && profileField(request.resource.data, 'email') == null
          && profileField(request.resource.data, 'phoneE164') == null
          && profileField(request.resource.data, 'whatsappNumber') == null;
    }
    function contactFieldsUpdateOk() {
      return (request.resource.data.get('email', null) == resource.data.get('email', null)
                || request.resource.data.get('email', null) == request.auth.token.get('email', null))
          && request.resource.data.get('phoneE164', null) == resource.data.get('phoneE164', null)
          && request.resource.data.get('whatsappNumber', null) == resource.data.get('whatsappNumber', null)
          && request.resource.data.get('verifiedContacts', null) == resource.data.get('verifiedContacts', null)
          && profileField(request.resource.data, 'email') == profileField(resource.data, 'email')
          && profileField(request.resource.data, 'phoneE164') == profileField(resource.data, 'phoneE164')
          && profileField(request.resource.data, 'whatsappNumber') == profileField(resource.data, 'whatsappNumber');
    }

    // ── User documents — only owner can read/write ──────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Credits are granted exclusively by the server (credits-initialize
      // writes the ledger entry) — a client create must not include them.
      allow create: if isOwner(userId)
                    && !('subscription' in request.resource.data)
                    && !('credits' in request.resource.data)
                    && !('referral' in request.resource.data)
                    && !('referredBy' in request.resource.data)
                    && !('referralClaimedAt' in request.resource.data)
                    && contactFieldsCreateOk();

      // Money, subscription, and referral state are server-owned through
      // Admin SDK. Explicit field equality is more robust than
      // diff().affectedKeys(), which only reports top-level keys and is easy
      // to get subtly wrong. Referral fields may be absent, so compare via
      // get() with a null default — a client-writable referral.code would let
      // an attacker hijack another user's referral rewards.
      // Memory controls: the owner may edit/clear their own `atman` memory
      // and toggle `memoryPaused` (must be a bool; the server skips memory
      // extraction while it is true).
      allow update: if isOwner(userId)
                    && request.resource.data.credits == resource.data.credits
                    && request.resource.data.subscription == resource.data.subscription
                    && request.resource.data.get('referral', null) == resource.data.get('referral', null)
                    && request.resource.data.get('referredBy', null) == resource.data.get('referredBy', null)
                    && request.resource.data.get('referralClaimedAt', null) == resource.data.get('referralClaimedAt', null)
                    && request.resource.data.get('activeConsultSessionId', null) == resource.data.get('activeConsultSessionId', null)
                    && request.resource.data.get('memoryPaused', false) is bool
                    && contactFieldsUpdateOk();

      // Chats subcollection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);

        // Messages subcollection within chats
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Consultations are billed server-side. Users can read receipts only.
      match /consultations/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;

        // The transcript is the user's own conversation — owner read/write.
        // Billing fields live on the parent doc, which stays server-only.
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Consultation reviews — written server-side only (verifies the session
      // actually happened). Owner may read their own.
      match /consultations_reviews/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Server-written review/feedback records. Owner-read, server-write only.
      match /consultationReviews/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /testimonialSubmissions/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /predictionFeedback/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /referralClaims/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /pushTokens/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /creditLedger/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /reports/{reportId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /digests/{digestId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Friends / inner circle subcollection
      match /friends/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Referrals — reward grants are server-owned (Admin SDK) to prevent
      // self-referral / reward farming. Each doc holds a referee's (masked)
      // contact, so it is served ONLY via the referral-info API, never read
      // directly — otherwise a referrer could list their referees' data.
      match /referrals/{docId} {
        allow read, write: if false;
      }
    }

    // ── Shared astronomical data — authenticated read, server-only write ─
    match /panchang/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }

    // Transit report cache — served exclusively by the transit function via
    // Admin SDK. Client reads would let any signed-in user list the collection
    // and harvest other users' birth data from cached docs.
    match /transit_reports/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // ── OTP collection — server-only (no client access) ──────────────
    match /otps/{email} {
      allow read, write: if false; // Admin SDK only
    }

    match /paymentOrders/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    match /auditLogs/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    match /rateLimits/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    match /webhookEvents/{docId} {
      allow read, write: if false; // Admin SDK only
    }

    // ── Default-deny catch-all ───────────────────────────────────────
    // Any collection not explicitly matched above (analyticsEvents,
    // expertApplications, supportTickets, remedyRequests, trustModerationQueue,
    // predictionFeedbackAggregateQueue, astrologers, healthchecks, …) is
    // server-only. This is defense-in-depth on top of Firestore's implicit
    // default-deny, so a future console edit can't silently open them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
